# ─────────────────────────────────────────────
# Eventura AI — environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://eventura:eventura@localhost:5432/eventura
SYNC_DATABASE_URL=postgresql+psycopg2://eventura:eventura@localhost:5432/eventura

# ── LLM providers ─────────────────────────────
# Primary provider: gemini | groq | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Secondary provider
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embeddings ────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Observability ─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eventura-ai

# Toggle: langfuse | langsmith | none
OBSERVABILITY_PROVIDER=none

# ── Mock vendor marketplace ────────────────────
MOCK_VENDOR_BASE_URL=http://localhost:8001

# ── WhatsApp ──────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Weather (optional) ────────────────────────
WEATHER_API_KEY=

# ── App settings ──────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
